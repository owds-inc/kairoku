#!/usr/bin/env bash
# hikyaku — provision and verify an agent machine.
#
#   ./hikyaku setup     provision THIS machine (idempotent; safe on a live one)
#   ./hikyaku doctor    verify THIS machine, change nothing
#
# Run it ON the target machine, from a clone of this repo:
#
#   gh auth login
#   gh repo clone owds-inc/hikyaku ~/work/hikyaku
#   cd ~/work/hikyaku && ./hikyaku setup && ./hikyaku doctor
#
# Bash, not TypeScript, deliberately: setup installs bun, so a bun-run CLI
# could not bootstrap a bare machine.
#
# The steps and every gotcha comment below come from orch/setup-agent-vm.sh in
# the kairoku-plan repo, which pushed the same work from the Mac. This inverts
# that model — the machine provisions itself — so nothing depends on the
# operator's laptop being configured.

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
HIKYAKU_HOME="$HOME/.hikyaku"
KAIROKU_REPO="bikerwhocodes/kairoku"
KAIROKU_DIR="$HOME/work/kairoku"
NODE_MAJOR=24

bold=$'\033[1m'; red=$'\033[31m'; green=$'\033[32m'; yellow=$'\033[33m'; dim=$'\033[2m'; off=$'\033[0m'
[ -t 1 ] || { bold=""; red=""; green=""; yellow=""; dim=""; off=""; }

step() { printf '\n%s== %s%s\n' "$bold" "$1" "$off"; }
info() { printf '   %s\n' "$1"; }
good() { printf '   %s✔%s %s\n' "$green" "$off" "$1"; }
warn() { printf '   %s!%s %s\n' "$yellow" "$off" "$1"; }
skip() { printf '   %s–%s %s\n' "$dim" "$off" "$1"; }

have() { command -v "$1" >/dev/null 2>&1; }
sudo_ok() { sudo -n true 2>/dev/null; }
lan_ip() { hostname -I | awk '{print $1}'; }

node_major() {
  have node || { echo 0; return; }
  node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/'
}

# The directory holding the node binary — the systemd units need it on PATH.
node_bin_dir() {
  have node && dirname "$(command -v node)" || echo ""
}

# Join non-empty path elements. An empty element in PATH means "the current
# directory", which is not something to leave lying around in a systemd unit.
path_join() {
  local out="" p
  for p in "$@"; do
    [ -n "$p" ] || continue
    out="${out:+$out:}$p"
  done
  printf '%s' "$out"
}

# ---------------------------------------------------------------- setup

setup_runtimes() {
  step "runtimes"

  if [ "$(node_major)" -ge "$NODE_MAJOR" ]; then
    skip "node $(node --version) already ≥ $NODE_MAJOR — not upgrading"
  else
    info "installing nvm + node $NODE_MAJOR"
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] ||
      curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/master/install.sh | bash >/dev/null 2>&1
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm install "$NODE_MAJOR" >/dev/null 2>&1
    good "node $(node --version)"
  fi

  if have bun; then
    skip "bun $(bun --version) already installed"
  else
    curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1
    export PATH="$HOME/.bun/bin:$PATH"
    good "bun $(bun --version)"
  fi

  # Only what is missing. This is provisioning, not an update channel: a rerun
  # on a live machine must not swap the CLI versions out from under a run.
  local want=(@anthropic-ai/claude-code @openai/codex @getpaseo/cli)
  local bins=(claude codex paseo)
  local missing=()
  local i
  for i in "${!bins[@]}"; do
    have "${bins[$i]}" || missing+=("${want[$i]}")
  done
  if [ ${#missing[@]} -eq 0 ]; then
    skip "claude, codex, paseo all present"
  else
    info "npm install -g ${missing[*]}"
    npm install -g "${missing[@]}" >/dev/null 2>&1
  fi

  for i in node bun claude codex paseo; do
    have "$i" && info "$(printf '%-7s %s' "$i" "$("$i" --version 2>/dev/null | head -1)")"
  done
}

setup_path() {
  step "non-interactive PATH"
  # Ubuntu's .bashrc returns early for non-interactive shells, and nvm's own
  # PATH lines sit BELOW that guard — so they never run for `ssh host cmd`,
  # which is how every remote command and systemd-adjacent check arrives. The
  # export has to be the FIRST line of .bashrc, above the guard.
  if grep -q '\.bun/bin' "$HOME/.bashrc" 2>/dev/null; then
    skip "PATH export already above the interactive guard"
    return
  fi
  local nodebin; nodebin="$(node_bin_dir)"
  sed -i "1i export PATH=\"$(path_join "$HOME/.bun/bin" "$nodebin"):\$PATH\"" "$HOME/.bashrc"
  good "prepended to ~/.bashrc line 1"
}

setup_kairoku() {
  step "kairoku checkout (worktree base)"
  if ! gh auth status >/dev/null 2>&1; then
    warn "gh is not authenticated — skipping the clone"
    warn "run 'gh auth login', then rerun ./hikyaku setup"
    return
  fi
  mkdir -p "$HOME/work"
  if [ -d "$KAIROKU_DIR/.git" ]; then
    skip "already at $KAIROKU_DIR"
  else
    gh repo clone "$KAIROKU_REPO" "$KAIROKU_DIR" >/dev/null 2>&1
    good "cloned $KAIROKU_REPO"
  fi
  ( cd "$KAIROKU_DIR" && bun install --silent >/dev/null 2>&1 ) || warn "bun install reported a problem"
  info "$KAIROKU_DIR at $(git -C "$KAIROKU_DIR" rev-parse --short HEAD)"
}

setup_userns() {
  step "codex sandbox prerequisite (unprivileged user namespaces)"
  # Ubuntu 24.04+ restricts unprivileged user namespaces; codex exec's sandbox
  # (bubblewrap) then fails with "bwrap: loopback: Failed RTM_NEWADDR".
  if ! sudo_ok; then
    warn "no passwordless sudo — skipped. Run by hand:"
    warn "  sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0"
    warn "  echo kernel.apparmor_restrict_unprivileged_userns=0 | sudo tee /etc/sysctl.d/99-codex-userns.conf"
    return
  fi
  local current; current="$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || echo missing)"
  if [ "$current" = "0" ] && [ -f /etc/sysctl.d/99-codex-userns.conf ]; then
    skip "already 0 and persisted"
    return
  fi
  sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0 >/dev/null
  echo "kernel.apparmor_restrict_unprivileged_userns=0" | sudo tee /etc/sysctl.d/99-codex-userns.conf >/dev/null
  good "set to 0 and persisted in /etc/sysctl.d/99-codex-userns.conf"
}

setup_codex_config() {
  step "codex MCP approval mode"
  # approval_policy "never" auto-DENIES approval requests, and a Kairoku MCP
  # write generates one unless the server's mode is "approve" (pre-approved).
  # "auto" is NOT enough — writes still prompt, and then get denied.
  local cfg="$HOME/.codex/config.toml"
  if [ ! -f "$cfg" ]; then
    warn "no ~/.codex/config.toml yet — run 'codex login' and add the kairoku"
    warn "MCP server first, then rerun ./hikyaku setup"
    return
  fi
  if grep -q 'default_tools_approval_mode' "$cfg"; then
    skip "default_tools_approval_mode already set"
    return
  fi
  if ! grep -q 'bearer_token_env_var = "KAIROKU_PAT"' "$cfg"; then
    warn "kairoku MCP entry not found in $cfg — add it with:"
    warn "  timeout 15 codex mcp add kairoku --url https://kairoku.io/api/mcp \\"
    warn "    --bearer-token-env-var KAIROKU_PAT   # the add command hangs after"
    warn "                                          # writing; the config lands"
    return
  fi
  sed -i '/^bearer_token_env_var = "KAIROKU_PAT"/a default_tools_approval_mode = "approve"' "$cfg"
  good 'default_tools_approval_mode = "approve"'
}

setup_hikyaku() {
  step "hikyaku daemon"
  mkdir -p "$HIKYAKU_HOME"

  if [ -f "$HIKYAKU_HOME/token.env" ]; then
    skip "bearer token already present (not shown, not regenerated)"
  else
    local token
    token="$( (openssl rand -hex 32 2>/dev/null) || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' )"
    umask 077
    printf 'HIKYAKU_TOKEN=%s\n' "$token" > "$HIKYAKU_HOME/token.env"
    unset token
    chmod 600 "$HIKYAKU_HOME/token.env"
    good "generated on this machine, chmod 600, never printed"
  fi

  if [ -f "$HIKYAKU_HOME/config.json" ]; then
    skip "config.json already present"
  else
    printf '{ "listen": { "host": "%s", "port": 7801 }, "maxConcurrent": 2, "repoPath": "%s" }\n' \
      "$(lan_ip)" "$KAIROKU_DIR" > "$HIKYAKU_HOME/config.json"
    good "config.json bound to $(lan_ip):7801 (never 0.0.0.0)"
  fi

  ( cd "$REPO_ROOT" && bun install --silent >/dev/null 2>&1 ) || warn "bun install reported a problem"

  if ! sudo_ok; then
    warn "no passwordless sudo — the systemd unit was not installed."
    warn "Everything else is in place; install the unit by hand when you have sudo."
    return
  fi

  local unit=/etc/systemd/system/hikyaku.service
  local staged; staged="$(mktemp)"
  cat > "$staged" <<EOF
[Unit]
Description=hikyaku dispatch daemon
After=network-online.target

[Service]
User=$USER
EnvironmentFile=$HIKYAKU_HOME/token.env
Environment=PATH=$(path_join "$HOME/.bun/bin" "$(node_bin_dir)" /usr/bin /bin)
ExecStart=$(command -v bun) run $REPO_ROOT/src/server.ts
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

  # Only touch systemd when the unit would actually change. A rerun on a live
  # machine must not bounce a daemon that is mid-run.
  if [ -f "$unit" ] && sudo cmp -s "$staged" "$unit"; then
    rm -f "$staged"
    if [ "$(systemctl is-active hikyaku 2>/dev/null)" = "active" ]; then
      skip "unit unchanged and daemon active — left running"
      return
    fi
    info "unit unchanged; starting the daemon"
  else
    sudo cp "$staged" "$unit"
    rm -f "$staged"
    sudo systemctl daemon-reload
    good "unit written to $unit"
  fi

  sudo systemctl enable --now hikyaku >/dev/null 2>&1
  sleep 2
  info "hikyaku: $(systemctl is-active hikyaku)"
}

setup_paseo() {
  step "paseo cockpit"
  mkdir -p "$HOME/.paseo"
  if [ -f "$HOME/.paseo/config.json" ]; then
    skip "~/.paseo/config.json already present"
  else
    printf '{ "daemon": { "listen": "%s:6767" } }\n' "$(lan_ip)" > "$HOME/.paseo/config.json"
    good "bound to $(lan_ip):6767"
  fi

  if [ -f /etc/systemd/system/paseo.service ]; then
    skip "unit installed ($(systemctl is-active paseo 2>/dev/null))"
    return
  fi
  if [ -f "$HOME/paseo.service" ]; then
    skip "unit staged at ~/paseo.service (password still to set)"
    return
  fi
  # paseo 0.6.x: the subcommand is "daemon start --foreground" — "daemon run"
  # no longer exists. Environment=PATH must carry the node bin dir or paseo's
  # `#!/usr/bin/env node` shebang fails with "env: node: No such file".
  cat > "$HOME/paseo.service" <<EOF
[Unit]
Description=Paseo daemon
After=network-online.target

[Service]
User=$USER
Environment=PASEO_PASSWORD=CHANGE-ME
Environment=PATH=$(path_join "$HOME/.bun/bin" "$(node_bin_dir)" /usr/bin /bin)
ExecStart=$(command -v paseo) daemon start --foreground
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
  good "staged at ~/paseo.service — set the password before installing it"
}

cmd_setup() {
  printf '%shikyaku setup%s — %s\n' "$bold" "$off" "$(hostname) ($(lan_ip))"
  info "repo: $REPO_ROOT"
  setup_runtimes
  PATH="$(path_join "$HOME/.bun/bin" "$(node_bin_dir)" "$PATH")"; export PATH
  setup_path
  setup_kairoku
  setup_userns
  setup_codex_config
  setup_hikyaku
  setup_paseo

  print_remainder
}

# Only what is still owed. A checklist that lists steps already done teaches
# the reader to skim it, which is how the one line that mattered gets missed.
print_remainder() {
  local owed=()

  gh auth status >/dev/null 2>&1 ||
    owed+=("gh auth login                # then rerun ./hikyaku setup for the kairoku clone")
  [ -d "$HOME/.claude" ] ||
    owed+=("claude                       # then /login  (browser)")
  [ -f "$HOME/.codex/auth.json" ] ||
    owed+=("codex login                  # (browser)")
  grep -q 'default_tools_approval_mode' "$HOME/.codex/config.toml" 2>/dev/null ||
    owed+=("timeout 15 codex mcp add kairoku --url https://kairoku.io/api/mcp --bearer-token-env-var KAIROKU_PAT
                               # the add command hangs after writing; the config still lands.
                               # Then rerun ./hikyaku setup to pre-approve MCP writes.")
  if [ ! -f /etc/systemd/system/paseo.service ]; then
    owed+=("nano ~/paseo.service         # set PASEO_PASSWORD, then:
    sudo cp ~/paseo.service /etc/systemd/system/paseo.service
    sudo systemctl daemon-reload && sudo systemctl enable --now paseo")
  fi
  sudo_ok ||
    owed+=("(no passwordless sudo — see the skipped steps above)")

  printf '\n%s== done.%s ' "$bold" "$off"
  if [ ${#owed[@]} -eq 0 ]; then
    printf 'Nothing human-only is outstanding on this machine.\n'
  else
    printf 'What is left is human-only:\n\n'
    local item
    for item in "${owed[@]}"; do printf '  %s\n' "$item"; done
  fi
  printf '\n  At dispatch time: export KAIROKU_PAT=…  (the slot PAT — never stored here)\n'
  printf '\nThen: ./hikyaku doctor\n'
}

# ---------------------------------------------------------------- doctor

FAILURES=0
WARNINGS=0

pass() { printf '   %sPASS%s  %-34s %s\n' "$green" "$off" "$1" "${2:-}"; }
fail() { printf '   %sFAIL%s  %-34s %s\n' "$red" "$off" "$1" "${2:-}"; FAILURES=$((FAILURES + 1)); }
note() { printf '   %sWARN%s  %-34s %s\n' "$yellow" "$off" "$1" "${2:-}"; WARNINGS=$((WARNINGS + 1)); }

# Two shapes, kept separate on purpose: one pattern that accepted both captured
# the whitespace before a closing brace, so `"port": 7801 }` parsed as "7801 "
# and every URL built from it was malformed.
json_string() { sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -1; }
json_number() { sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" "$1" | head -1; }

cmd_doctor() {
  printf '%shikyaku doctor%s — %s (%s)\n' "$bold" "$off" "$(hostname)" "$(lan_ip)"

  step "toolchain"
  if [ "$(node_major)" -ge "$NODE_MAJOR" ]; then
    pass "node ≥ $NODE_MAJOR" "$(node --version)"
  else
    fail "node ≥ $NODE_MAJOR" "found $(have node && node --version || echo none)"
  fi
  local b
  for b in bun claude codex; do
    if have "$b"; then pass "$b installed" "$("$b" --version 2>/dev/null | head -1)"
    else fail "$b installed" "not on PATH"; fi
  done
  if have paseo; then pass "paseo installed" "$(paseo --version 2>/dev/null | head -1)"
  else note "paseo installed" "absent (cockpit is optional)"; fi

  step "non-interactive PATH"
  # The failure this catches: `ssh host bun --version` finding nothing because
  # the PATH export sits below .bashrc's interactive guard.
  local first; first="$(head -1 "$HOME/.bashrc" 2>/dev/null || true)"
  if [[ "$first" == export\ PATH=* && "$first" == *".bun/bin"* ]]; then
    pass "PATH export is ~/.bashrc line 1"
    local dir missing=""
    for dir in $(printf '%s' "$first" | sed 's/^export PATH="//; s/:\$PATH"$//' | tr ':' ' '); do
      [ -d "$dir" ] || missing="$missing $dir"
    done
    if [ -z "$missing" ]; then pass "exported dirs exist"
    else fail "exported dirs exist" "missing:$missing"; fi
  else
    fail "PATH export is ~/.bashrc line 1" "found: ${first:-<empty>}"
  fi

  step "codex sandbox"
  local userns; userns="$(sysctl -n kernel.apparmor_restrict_unprivileged_userns 2>/dev/null || echo missing)"
  if [ "$userns" = "0" ]; then pass "userns unrestricted" "sysctl = 0"
  elif [ "$userns" = "missing" ]; then note "userns unrestricted" "sysctl key absent on this kernel"
  else fail "userns unrestricted" "sysctl = $userns (codex sandbox will fail)"; fi

  if [ -f "$HOME/.codex/config.toml" ] &&
     grep -q 'default_tools_approval_mode = "approve"' "$HOME/.codex/config.toml"; then
    pass "codex MCP writes pre-approved"
  else
    fail "codex MCP writes pre-approved" 'default_tools_approval_mode = "approve" not set'
  fi

  step "hikyaku daemon"
  if [ -f "$HIKYAKU_HOME/config.json" ]; then pass "~/.hikyaku/config.json"
  else fail "~/.hikyaku/config.json" "absent"; fi

  local perms=""
  if [ -f "$HIKYAKU_HOME/token.env" ]; then
    perms="$(stat -c '%a' "$HIKYAKU_HOME/token.env" 2>/dev/null || stat -f '%Lp' "$HIKYAKU_HOME/token.env")"
    if [ "$perms" = "600" ]; then pass "~/.hikyaku/token.env" "mode 600"
    else fail "~/.hikyaku/token.env" "mode $perms — must be 600"; fi
  else
    fail "~/.hikyaku/token.env" "absent"
  fi

  local active; active="$(systemctl is-active hikyaku 2>/dev/null || true)"
  if [ "$active" = "active" ]; then pass "hikyaku.service" "active, $(systemctl is-enabled hikyaku 2>/dev/null)"
  else fail "hikyaku.service" "${active:-not installed}"; fi

  if [ -f "$HIKYAKU_HOME/config.json" ] && [ -f "$HIKYAKU_HOME/token.env" ] && have curl; then
    local host port url code
    host="$(json_string "$HIKYAKU_HOME/config.json" host)"
    port="$(json_number "$HIKYAKU_HOME/config.json" port)"
    url="http://$host:$port/capacity"

    code="$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$url" 2>/dev/null || true)"
    code="${code:-000}"
    if [ "$code" = "401" ]; then pass "unauthenticated request refused" "401"
    else fail "unauthenticated request refused" "got $code, expected 401"; fi

    # The token is read into a subshell and never echoed.
    local body
    body="$( set +u; . "$HIKYAKU_HOME/token.env"
             curl -s -m 5 -H "authorization: Bearer $HIKYAKU_TOKEN" "$url" || true )"
    if printf '%s' "$body" | grep -q '"max"'; then pass "authenticated request answers" "$body"
    else fail "authenticated request answers" "got: ${body:-<no response>}"; fi
  else
    fail "daemon reachable" "cannot test — config, token or curl missing"
  fi

  step "paseo cockpit"
  if [ -f /etc/systemd/system/paseo.service ]; then
    active="$(systemctl is-active paseo 2>/dev/null || true)"
    if [ "$active" = "active" ]; then pass "paseo.service" "active"
    else fail "paseo.service" "$active"; fi
  elif [ -f "$HOME/paseo.service" ]; then
    note "paseo.service" "staged, not installed (password still to set)"
  else
    note "paseo.service" "not configured (cockpit is optional)"
  fi

  step "kairoku worktree base"
  local repo; repo="$(json_string "$HIKYAKU_HOME/config.json" repoPath 2>/dev/null || true)"
  repo="${repo:-$KAIROKU_DIR}"
  if [ -d "$repo/.git" ]; then
    pass "repo present" "$repo at $(git -C "$repo" rev-parse --short HEAD)"
    if [ -z "$(git -C "$repo" status --porcelain)" ]; then pass "repo clean"
    else note "repo clean" "$(git -C "$repo" status --porcelain | wc -l | tr -d ' ') modified path(s)"; fi
  else
    fail "repo present" "$repo is not a git checkout"
  fi

  printf '\n'
  if [ "$FAILURES" -eq 0 ]; then
    printf '%s✔ all checks passed%s%s\n' "$green" "$off" \
      "$([ "$WARNINGS" -gt 0 ] && printf ' (%d warning(s))' "$WARNINGS")"
    return 0
  fi
  printf '%s✘ %d check(s) failed%s\n' "$red" "$FAILURES" "$off"
  return 1
}

# ---------------------------------------------------------------- dispatch

cmd_help() {
  cat <<'USAGE'
hikyaku — provision and verify an agent machine.

  hikyaku setup     provision THIS machine. Idempotent: safe to rerun on a
                    machine whose daemons are live and mid-run.
  hikyaku doctor    verify THIS machine and change nothing. Nonzero exit if
                    any check fails.
  hikyaku help      this.

Mainline flow on a fresh machine:

  gh auth login
  gh repo clone owds-inc/hikyaku ~/work/hikyaku
  cd ~/work/hikyaku
  ./hikyaku setup          # then do the human-only steps it prints
  ./hikyaku setup          # rerun: picks up the clone once gh is authed
  ./hikyaku doctor
USAGE
}

case "${1:-help}" in
  setup)         cmd_setup ;;
  doctor)        cmd_doctor ;;
  help|-h|--help) cmd_help ;;
  *) printf '%shikyaku: unknown command %q%s\n\n' "$red" "$1" "$off" >&2; cmd_help >&2; exit 2 ;;
esac
